echo -n "I can't find starship, would you like me to install it for you? (y/N) "

if [ -t 0 ]; then
        read ans
else
    ans=y   # no terminal can answer: install rather than block a script or an agent
fi
if [[ "$ans" == "y" ]]; then
    curl -sS https://starship.rs/install.sh | sh
    echo "...installed starship!"
fi
