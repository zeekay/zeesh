zeesh-plugin-enable() {
    if [ $1 ]; then
        local plugin=$1
        local plugin_dir="$HOME/.zsh/plugins/$plugin"
        local plugin_file="$plugin_dir/plugin"
        
        if [[ -f "$plugin_file" ]]; then
            source "$plugin_file"
        else
            echo "zeesh: plugin '$plugin' not found or invalid" >&2
            return 1
        fi
    else
        # Source each plugin in zeesh_plugins
        local plugin plugin_dir plugin_file
        for plugin in $zeesh_plugins; do
            plugin_dir="$HOME/.zsh/plugins/$plugin"
            plugin_file="$plugin_dir/plugin"
            
            if [[ -f "$plugin_file" ]]; then
                source "$plugin_file"
            else
                echo "zeesh: plugin '$plugin' not found, skipping" >&2
            fi
        done
    fi
}

