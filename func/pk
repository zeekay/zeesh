# kill matching processes
#
# One ps line per process: the lines are iterated quoted, because zsh here
# runs with SH_WORD_SPLIT (bash-style splitting of unquoted $vars), which would
# otherwise hand the loop every word of every line and kill nothing.
pk() {
    [[ -n $1 ]] || return 1
    local opts=ux
    [[ $EUID -eq 0 ]] && opts=uax

    local -a lines fields
    lines=("${(@f)$(ps $opts | grep --color=never -- "$1" | grep -v grep)}")
    if [[ -z ${lines[1]} ]]; then
        echo "No matches"
        return 1
    fi

    echo "killed:"
    ps $opts | head -n 1
    local line
    for line in "${lines[@]}"; do
        print -r -- "$line" | grep --color=auto -- "$1"
        fields=(${=line})
        kill -9 "${fields[2]}"
    done
}

